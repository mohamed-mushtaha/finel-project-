# Copy this file to local.properties and fill in real values.
# local.properties is gitignored.

# Android SDK location (Android Studio sets this automatically)
sdk.dir=C\:\\Users\\YourUser\\AppData\\Local\\Android\\Sdk

# Google Maps API key — get one from https://console.cloud.google.com/
# Enable: Maps SDK for Android, Directions API
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
